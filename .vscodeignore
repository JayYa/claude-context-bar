# VCS
**/.git
**/.svn
**/.hg
**/CVS

# OS artifacts
**/.DS_Store
**/Thumbs.db

# Dependencies
**/node_modules

# Build artifacts
*.vsix

# TypeScript source (compiled to out/)
src/

# Build configuration
tsconfig.json

# Dev tooling configs
.gitignore
.vscodeignore
.github/
.vscode/
.claude/

# Internal documentation (README.md and CHANGELOG.md are for the marketplace)
CLAUDE.md
DEV-README.md
INTERNAL-DEV-NOTES.md
whats-next.md

# Generated knowledge graph
graphify-out/

# Local backups
_BACKUPS/
**/_BACKUPS/

# Compiled test files
**/*.test.js
**/*.test.js.map

# Source maps (not needed in the published package)
out/**/*.js.map

# Lockfile (not needed at runtime; deps are bundled/none)
package-lock.json

# Internal agent + design docs
docs/
CONTEXT.md

# Editor/test scratch
.vscode-test/
.env
.env.*
*.log

# TypeScript incremental build info
**/*.tsbuildinfo
